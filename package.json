{
  "name": "war-tracker",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.2.23",
  "workspaces": [
    "apps/*",
    "cron",
    "tooling/*"
  ],
  "scripts": {
    "dev": "cd apps/worker && bunx alchemy dev",
    "dev:web": "cd apps/web && bun run dev",
    "deploy": "bun run build && bunx alchemy deploy",
    "destroy": "bunx alchemy deploy --destroy",
    "build": "cd apps/web && bun run build",
    "check": "bunx biome check .",
    "check:fix": "bunx biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "cd apps/worker && bunx drizzle-kit generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@cloudflare/workers-types": "^4.20260124.0",
    "@types/node": "^22.0.0",
    "alchemy": "^0.83.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "5.7.3",
    "wrangler": "^4.60.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.5",
    "zod": "^3.25.76"
  }
}
